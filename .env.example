# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Database (shared by the API, jobs.py, seed.py and the database tests)
CFMS_DB_HOST=localhost
CFMS_DB_PORT=5432
CFMS_DB_NAME=nvs
# Runtime login used by the API and jobs.py (member of nvs_app)
CFMS_DB_USER=nvs_api
CFMS_DB_PASSWORD=
# Schema owner used by seed.py and the database integration tests (never the API)
CFMS_SEED_DB_USER=nvs
CFMS_SEED_DB_PASSWORD=
CFMS_DATABASE_POOL_MIN=5
CFMS_DATABASE_POOL_MAX=10
# Uvicorn worker processes. Each worker owns its own async DB connection pool.
WEB_CONCURRENCY=1
# Local development only; keep true in shared/test/production environments.
CFMS_REQUIRE_PLATFORM_MFA=false
CFMS_PLATFORM_JWT_SECRET=
CFMS_PLATFORM_JWT_ISSUER=cfms-platform
CFMS_PLATFORM_JWT_AUDIENCE=cfms-super-admin-api
# Tenant access tokens are issued by the tenant authentication service.
CFMS_TENANT_JWT_SECRET=
CFMS_TENANT_JWT_ISSUER=cfms-tenant
CFMS_TENANT_JWT_AUDIENCE=cfms-tenant-api
# Hex key from SELECT app.context_signing_key_for_api(); signs the DB context.
CFMS_DB_CONTEXT_SIGNING_KEY=
CFMS_API_PREFIX=/api/v1
