{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cfms.local/schemas/workflow.schema.json",
  "title": "CFMS workflow definition",
  "description": "Versioned workflow document (cfg.workflow_version.definition): stages -> rule checks -> actions. The database validates the same rules on publish (cfg.validate_workflow), including references to roles, privileges, registered actions and entity statuses, which a static schema cannot check.",
  "type": "object",
  "required": ["workflow", "version", "schemaVersion", "startStage", "stages", "transitions"],
  "properties": {
    "workflow": {"$ref": "#/$defs/code"},
    "version": {"type": "integer", "minimum": 1},
    "schemaVersion": {"type": "string"},
    "startStage": {"$ref": "#/$defs/code"},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
  },
  "$defs": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "roleList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/code"}},
    "label": {
      "type": "object",
      "required": ["en"],
      "properties": {"en": {"type": "string", "minLength": 1}, "ta": {"type": "string"}},
      "propertyNames": {"pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
      "additionalProperties": {"type": "string"}
    },
    "formLabel": {
      "type": "object",
      "required": ["en", "ta"],
      "properties": {"en": {"type": "string", "minLength": 1}, "ta": {"type": "string", "minLength": 1}},
      "propertyNames": {"pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "stage": {
      "type": "object",
      "required": ["code", "name"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["INIT", "NORMAL"], "description": "INIT is the workflow initialization stage; it must be first and match startStage."},
        "end": {"type": "boolean"},
        "role": {"$ref": "#/$defs/code", "description": "Legacy: the acting role. Maker stages use actorPrivilege; approval stages use approval.roles."},
        "actorPrivilege": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"},
        "approval": {"$ref": "#/$defs/approval"},
        "statuses": {"$ref": "#/$defs/statuses"},
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["seq"],
            "oneOf": [{"required": ["code"]}, {"required": ["action"]}],
            "properties": {
              "seq": {"type": "integer", "minimum": 1},
              "code": {"$ref": "#/$defs/code"},
              "action": {"$ref": "#/$defs/code"},
              "event": {"enum": ["onEnter", "onExit"]},
              "params": {"type": "object"},
              "onError": {"enum": ["ROLLBACK", "CONTINUE", "DEFER"]},
              "type": {"type": "string"},
              "config": {"type": "object"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["roles", "minApprovals"],
      "properties": {
        "roles": {"$ref": "#/$defs/roleList"},
        "minApprovals": {"type": "integer", "minimum": 1},
        "allowOfflineRecording": {"type": "boolean"},
        "offlineRecorderRoles": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/code"}},
        "methods": {"type": "array", "items": {"enum": ["online", "offline"]}},
        "amountBands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["minAmount", "roles"],
            "properties": {
              "minAmount": {"type": "number", "minimum": 0},
              "roles": {"$ref": "#/$defs/roleList"},
              "minApprovals": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "statuses": {
      "type": "object",
      "required": ["stageStatuses", "initial"],
      "properties": {
        "entityStatus": {"$ref": "#/$defs/code", "description": "Entity status set when the stage is entered; one of the entity's fixed statuses (checked on publish)."},
        "initial": {"$ref": "#/$defs/code"},
        "onPartialApproval": {"$ref": "#/$defs/code"},
        "onRouted": {"$ref": "#/$defs/code"},
        "stageStatuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code"],
            "properties": {"code": {"$ref": "#/$defs/code"}, "label": {"$ref": "#/$defs/label"}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ruleCheck": {
      "oneOf": [
        {"$ref": "#/$defs/code"},
        {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": {"$ref": "#/$defs/code"},
            "onFail": {"enum": ["BLOCK", "REQUIRE_OVERRIDE", "ROUTE_TO_ROLE", "WARN"]},
            "roles": {"$ref": "#/$defs/roleList"}
          },
          "additionalProperties": false,
          "if": {"properties": {"onFail": {"const": "ROUTE_TO_ROLE"}}, "required": ["onFail"]},
          "then": {"required": ["roles"]}
        }
      ]
    },
    "formSection": {
      "type": "object",
      "required": ["code", "title", "fields"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "title": {"$ref": "#/$defs/formLabel"},
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "formInput": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/formField"}},
        "x-sections": {"type": "array", "items": {"$ref": "#/$defs/formSection"}}
      },
      "additionalProperties": true
    },
    "formField": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "x-field": {"enum": ["text", "multiline", "number", "amount", "date", "enum", "boolean", "member", "nominee"]},
        "title": {"$ref": "#/$defs/formLabel"},
        "enum": {"type": "array", "items": {}},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "exclusiveMinimum": {"type": "number"},
        "x-maxFrom": {"type": "string"},
        "x-showWhen": {"type": "string"}
      },
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "required": ["from", "to", "on"],
      "properties": {
        "from": {"$ref": "#/$defs/code"},
        "to": {"$ref": "#/$defs/code"},
        "on": {"$ref": "#/$defs/code"},
        "when": {"type": "object"},
        "code": {"$ref": "#/$defs/code"},
        "label": {"$ref": "#/$defs/label"},
        "style": {"enum": ["primary", "secondary", "danger"]},
        "confirm": {"$ref": "#/$defs/label"},
        "actor": {"type": "object"},
        "fromStatuses": {"type": "array", "items": {"$ref": "#/$defs/code"}},
        "input": {"$ref": "#/$defs/formInput"},
        "ruleChecks": {"type": "array", "items": {"$ref": "#/$defs/ruleCheck"}},
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"$ref": "#/$defs/code"}, "params": {"type": "object"}},
            "additionalProperties": false
          }
        },
        "stageStatus": {"$ref": "#/$defs/code", "description": "Stage status the transition records in its source stage."},
        "entityStatus": {"$ref": "#/$defs/code", "description": "Entity status the transition sets instead of the target stage's."}
      }
    }
  }
}
